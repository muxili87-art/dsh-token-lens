{
  "name": "dsh-token-lens",
  "version": "1.1.0",
  "description": "TokenLens · 用量透镜：DeepSeek Harness 插件，把本地会话日志变成 Token / 请求 / 费用 / 缓存命中 / 模型速度的可视化用量看板。",
  "license": "MIT",
  "author": "muxili87-art",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "homepage": "https://github.com/muxili87-art/dsh-token-lens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muxili87-art/dsh-token-lens.git"
  },
  "bugs": {
    "url": "https://github.com/muxili87-art/dsh-token-lens/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tokenlens",
    "usage",
    "dashboard",
    "token",
    "cost"
  ],
  "files": [
    "index.js",
    "fold.js",
    "client.js",
    "cordis.patch.yml",
    "pricing.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check fold.js && node --check client.js",
    "doctor": "node scripts/doctor.mjs",
    "pack": "sh scripts/build-release.sh",
    "verify": "npm run check && npm run doctor"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
